generator client {
  provider     = "prisma-client"
  output       = "../../../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NetworkCode {
  INNOVATION
  ENTREPRENEURSHIP
  GUIDANCE
  QUALITY
}

enum ActionStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  RETURNED
  ARCHIVED
}

model Center {
  id            String         @id @default(cuid())
  name          String
  code          String?        @unique
  createdAt     DateTime       @default(now())
  academicYears AcademicYear[]
  users         User[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  centerId  String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  actions   Action[]
  createdAt DateTime @default(now())

  @@unique([centerId, name])
  @@index([centerId, isActive])
}

model User {
  id           String     @id @default(cuid())
  centerId     String
  email        String
  firstName    String
  lastName     String
  passwordHash String?
  active       Boolean    @default(true)
  center       Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  roles        UserRole[]
  evidence     Evidence[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([centerId, email])
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Network {
  id          String          @id @default(cuid())
  code        NetworkCode     @unique
  name        String
  description String?
  sortOrder   Int
  active      Boolean         @default(true)
  actions     ActionNetwork[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Action {
  id               String          @id @default(cuid())
  academicYearId   String
  title            String
  description      String
  type             String
  status           ActionStatus    @default(PENDING_VALIDATION)
  activityDate     DateTime
  durationMinutes  Int?
  studentCount     Int?
  submittedByName  String
  submittedByEmail String
  validatedAt      DateTime?
  academicYear     AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  networks         ActionNetwork[]
  evidence         Evidence[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([academicYearId, status])
  @@index([activityDate])
  @@index([submittedByEmail])
}

model ActionNetwork {
  actionId  String
  networkId String
  action    Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  network   Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([actionId, networkId])
  @@index([networkId])
}

model Evidence {
  id           String   @id @default(cuid())
  actionId     String
  uploadedById String?
  kind         String
  title        String?
  path         String?
  url          String?
  mimeType     String?
  sizeBytes    Int?
  action       Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([actionId])
}

model Communication {
  id               String   @id @default(cuid())
  title            String
  body             String
  responseRequired Boolean  @default(false)
  deadline         DateTime?
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
}
