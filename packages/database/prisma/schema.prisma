generator client {
  provider     = "prisma-client"
  output       = "../../../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NetworkCode {
  INNOVATION
  ENTREPRENEURSHIP
  GUIDANCE
  QUALITY
}

enum ActionStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  RETURNED
  ARCHIVED
}

enum Shift {
  MORNING
  AFTERNOON
  BOTH
  UNSPECIFIED
}

enum CommunicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EmailOutboxStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum StaffRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AnnualPlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum PlanObjectiveStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PlanTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PlanMetric {
  ACTIONS
  PARTICIPATIONS
  HOURS
  EVIDENCE
}

model Center {
  id                   String               @id @default(cuid())
  name                 String
  code                 String?              @unique
  createdAt            DateTime             @default(now())
  academicYears        AcademicYear[]
  users                User[]
  professionalFamilies ProfessionalFamily[]
  integrationSettings  CenterIntegrationSettings?
}

model AcademicYear {
  id                  String                @id @default(cuid())
  centerId            String
  name                String
  startsAt            DateTime
  endsAt              DateTime
  isActive            Boolean               @default(false)
  closedAt            DateTime?
  center              Center                @relation(fields: [centerId], references: [id], onDelete: Cascade)
  actions             Action[]
  communications      Communication[]
  staffRequests        StaffRequest[]
  annualPlans          AnnualPlan[]
  groups               TeachingGroup[]
  networkCoordinators NetworkCoordinator[]
  ciclopeCoordinators CiclopeCoordinator[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([centerId, name])
  @@index([centerId, isActive])
}

model User {
  id                      String                    @id @default(cuid())
  centerId                String
  email                   String
  firstName               String
  lastName                String
  passwordHash            String?
  shift                   Shift                     @default(UNSPECIFIED)
  active                  Boolean                   @default(true)
  center                  Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  roles                   UserRole[]
  evidence                Evidence[]
  sessions                Session[]
  submittedActions        Action[]                  @relation("SubmittedActions")
  validatedActions        Action[]                  @relation("ValidatedActions")
  networkCoordinations    NetworkCoordinator[]
  ciclopeCoordinations    CiclopeCoordinator[]
  professionalFamilies    UserProfessionalFamily[]
  authoredCommunications  Communication[]           @relation("CommunicationAuthor")
  communicationRecipients CommunicationRecipient[]
  emailJobs               EmailOutbox[]
  submittedStaffRequests  StaffRequest[]            @relation("StaffRequestSubmitter")
  requestMessages         StaffRequestMessage[]
  planTasks               PlanTask[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@unique([centerId, email])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model ProfessionalFamily {
  id        String                   @id @default(cuid())
  centerId  String
  name      String
  code      String?
  active    Boolean                  @default(true)
  center    Center                   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  users     UserProfessionalFamily[]
  groups    TeachingGroup[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([centerId, name])
  @@unique([centerId, code])
  @@index([centerId, active])
}

model UserProfessionalFamily {
  userId               String
  professionalFamilyId String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalFamily    ProfessionalFamily @relation(fields: [professionalFamilyId], references: [id], onDelete: Cascade)

  @@id([userId, professionalFamilyId])
  @@index([professionalFamilyId])
}

model TeachingGroup {
  id                   String                @id @default(cuid())
  academicYearId       String
  professionalFamilyId String
  name                 String
  shift                Shift                 @default(UNSPECIFIED)
  studentCount         Int?
  active               Boolean               @default(true)
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  professionalFamily   ProfessionalFamily    @relation(fields: [professionalFamilyId], references: [id], onDelete: Restrict)
  actions              ActionTeachingGroup[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId, professionalFamilyId])
}

model Network {
  id             String                @id @default(cuid())
  code           NetworkCode           @unique
  name           String
  description    String?
  sortOrder      Int
  active         Boolean               @default(true)
  actions        ActionNetwork[]
  coordinators   NetworkCoordinator[]
  communications Communication[]
  staffRequests  StaffRequestNetwork[]
  annualPlans    AnnualPlan[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model NetworkCoordinator {
  id             String       @id @default(cuid())
  academicYearId String
  networkId      String
  userId         String
  isPrimary      Boolean      @default(true)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  network        Network      @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([academicYearId, networkId, userId])
  @@index([academicYearId, networkId])
  @@index([userId, academicYearId])
}

model CiclopeCoordinator {
  id             String       @id @default(cuid())
  academicYearId String
  userId         String
  isPrimary      Boolean      @default(true)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([academicYearId, userId])
  @@index([academicYearId])
  @@index([userId, academicYearId])
}

model Action {
  id               String                @id @default(cuid())
  academicYearId   String
  title            String
  description      String
  type             String
  status           ActionStatus          @default(PENDING_VALIDATION)
  activityDate     DateTime
  durationMinutes  Int?
  studentCount     Int?
  networkDetails   Json?
  submittedById    String?
  submittedByName  String
  submittedByEmail String
  validatedById    String?
  validatedAt      DateTime?
  returnedAt       DateTime?
  returnedReason   String?
  academicYear     AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  submittedBy      User?                 @relation("SubmittedActions", fields: [submittedById], references: [id], onDelete: SetNull)
  validatedBy      User?                 @relation("ValidatedActions", fields: [validatedById], references: [id], onDelete: SetNull)
  networks         ActionNetwork[]
  groups           ActionTeachingGroup[]
  evidence         Evidence[]
  objectives       ActionObjective[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([academicYearId, status])
  @@index([activityDate])
  @@index([submittedByEmail])
  @@index([submittedById])
}

model ActionNetwork {
  actionId  String
  networkId String
  action    Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  network   Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([actionId, networkId])
  @@index([networkId])
}

model ActionTeachingGroup {
  actionId        String
  teachingGroupId String
  action          Action        @relation(fields: [actionId], references: [id], onDelete: Cascade)
  teachingGroup   TeachingGroup @relation(fields: [teachingGroupId], references: [id], onDelete: Cascade)

  @@id([actionId, teachingGroupId])
  @@index([teachingGroupId])
}

model Evidence {
  id           String   @id @default(cuid())
  actionId     String
  uploadedById String?
  kind         String
  title        String?
  path         String?
  url          String?
  mimeType     String?
  sizeBytes    Int?
  action       Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([actionId])
}

model Communication {
  id               String                  @id @default(cuid())
  academicYearId   String
  authorId         String?
  originNetworkId  String?
  title            String
  body             String
  status           CommunicationStatus     @default(DRAFT)
  responseRequired Boolean                 @default(false)
  deadline         DateTime?
  publishedAt      DateTime?
  academicYear     AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  author           User?                   @relation("CommunicationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  originNetwork    Network?                @relation(fields: [originNetworkId], references: [id], onDelete: SetNull)
  recipients       CommunicationRecipient[]
  emailJobs         EmailOutbox[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([academicYearId, status])
  @@index([originNetworkId])
  @@index([authorId])
}

model CommunicationRecipient {
  communicationId String
  userId          String
  deliveredAt     DateTime?
  readAt          DateTime?
  respondedAt     DateTime?
  responseText    String?
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communicationId, userId])
  @@index([userId, readAt])
}

model EmailOutbox {
  id              String            @id @default(cuid())
  dedupeKey       String?           @unique
  communicationId String?
  userId          String?
  recipientEmail  String
  subject         String
  textBody        String
  status          EmailOutboxStatus @default(QUEUED)
  attempts        Int               @default(0)
  nextAttemptAt   DateTime          @default(now())
  lastError       String?
  sentAt          DateTime?
  communication   Communication?    @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([communicationId])
  @@index([userId])
}

model StaffRequest {
  id             String             @id @default(cuid())
  academicYearId String
  submittedById  String
  category       String
  subject        String
  status         StaffRequestStatus @default(NEW)
  resolvedAt     DateTime?
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  submittedBy    User               @relation("StaffRequestSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  networks       StaffRequestNetwork[]
  messages       StaffRequestMessage[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([academicYearId, status])
  @@index([submittedById, academicYearId])
}

model StaffRequestNetwork {
  requestId String
  networkId String
  request   StaffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  network   Network      @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([requestId, networkId])
  @@index([networkId])
}

model StaffRequestMessage {
  id        String       @id @default(cuid())
  requestId String
  authorId  String
  body      String
  request   StaffRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@index([requestId, createdAt])
  @@index([authorId])
}

model AnnualPlan {
  id             String           @id @default(cuid())
  academicYearId String
  networkId      String
  title          String
  summary        String?
  status         AnnualPlanStatus @default(DRAFT)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  network        Network          @relation(fields: [networkId], references: [id], onDelete: Restrict)
  objectives     PlanObjective[]
  tasks          PlanTask[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([academicYearId, networkId])
  @@index([academicYearId, status])
}

model PlanObjective {
  id          String              @id @default(cuid())
  planId      String
  title       String
  description String?
  metric      PlanMetric?
  targetValue Float?
  sortOrder   Int                 @default(0)
  status      PlanObjectiveStatus @default(PLANNED)
  plan        AnnualPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks       PlanTask[]
  actions     ActionObjective[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([planId, sortOrder])
}

model PlanTask {
  id          String         @id @default(cuid())
  planId      String
  objectiveId String?
  ownerId     String?
  title       String
  description String?
  dueDate     DateTime?
  status      PlanTaskStatus @default(TODO)
  official    Boolean        @default(false)
  officialKey String?
  completedAt DateTime?
  plan        AnnualPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  objective   PlanObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([planId, officialKey])
  @@index([planId, status])
  @@index([ownerId, dueDate])
  @@index([dueDate, status])
}

model ActionObjective {
  actionId    String
  objectiveId String
  action      Action        @relation(fields: [actionId], references: [id], onDelete: Cascade)
  objective   PlanObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([actionId, objectiveId])
  @@index([objectiveId])
}


model CenterIntegrationSettings {
  id                    String   @id @default(cuid())
  centerId              String   @unique
  resendEnabled         Boolean  @default(false)
  resendApiKeyEncrypted String?
  resendFromEmail       String?
  resendFromName        String?
  aiEnabled             Boolean  @default(false)
  aiProviderName        String?
  aiBaseUrl             String?
  aiModel               String?
  aiApiKeyEncrypted     String?
  center                Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
