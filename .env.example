NODE_ENV=production
DATABASE_URL=postgresql://ciclope:CHANGE_ME@127.0.0.1:5432/ciclope
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
UPLOAD_DIR=/var/lib/ciclope-fp/uploads
APP_BASE_URL=https://redesfp.example.org
APP_TIME_ZONE=Atlantic/Canary
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
INTEGRATIONS_ENCRYPTION_KEY=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE

# Resend y la API de IA se configuran desde Administración > Integraciones.
# Sus claves se cifran en PostgreSQL con INTEGRATIONS_ENCRYPTION_KEY.


# Automatizaciones internas. No requieren cron ni servicios adicionales.
AUTOMATIONS_ENABLED=true
AUTOMATIONS_INTERVAL_MINUTES=60
TASK_REMINDER_DAYS=3
COMMUNICATION_REMINDER_HOURS=24
MILESTONE_REMINDER_DAYS=7
WEEKLY_SUMMARY_WEEKDAY=MON

# Evidencias
EVIDENCE_MAX_MB=25
# Lista separada por comas. Si se deja vacía se usan los formatos seguros incluidos por defecto.
EVIDENCE_ALLOWED_MIME_TYPES=
