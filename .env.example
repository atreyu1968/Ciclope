NODE_ENV=production
DATABASE_URL=postgresql://ciclope:CHANGE_ME@127.0.0.1:5432/ciclope
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api
UPLOAD_DIR=/var/lib/ciclope-fp/uploads
APP_BASE_URL=https://redesfp.example.org
APP_TIME_ZONE=Atlantic/Canary
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE

# Avisos por correo. Si SMTP_HOST o SMTP_FROM quedan vacíos,
# las comunicaciones seguirán disponibles en el portal pero no se enviarán emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# Automatizaciones internas. No requieren cron ni servicios adicionales.
AUTOMATIONS_ENABLED=true
AUTOMATIONS_INTERVAL_MINUTES=60
TASK_REMINDER_DAYS=3
COMMUNICATION_REMINDER_HOURS=24
